---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatPostDate,
  getPostSlug,
  getPublishedPosts,
} from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="文章" description="按时间倒序整理的博客文章列表。">
  <section class="content-section">
    <div class="section-heading">
      <p class="eyebrow">文章列表</p>
      <h1>所有文章</h1>
      <p>按发布日期倒序排列，包含摘要、标签和详情入口。</p>
    </div>
    <div class="post-list">
      {
        posts.map((post) => (
          <article class="post-card">
            <div class="post-card-meta">
              <time datetime={post.data.publishDate.toISOString()}>
                {formatPostDate(post.data.publishDate)}
              </time>
              <ul class="tag-list" aria-label={`${post.data.title} 标签`}>
                {post.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>
            <h2>
              <a href={`/posts/${getPostSlug(post)}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
